# Used by `npm run build:app` (the iPhone and Android apps).
# The phone apps load their screens from inside the app, so they need the full
# address of the live server. Not a secret: the server's passcode protects it.
VITE_API_URL=https://shoo.onrender.com
# Apple's numeric app id (App Store Connect → your app → App Information → Apple ID).
# Turns on the "Rate Shoo" button on iPhone. Leave empty until the app exists.
VITE_APP_STORE_ID=
